# ---- core ----
ENV=development                       # production on Render
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require     # Neon connection string (pooled endpoint is fine)
SECRET_KEY=change-me                  # python -c "import secrets;print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEYS=                # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FRONTEND_URL=http://localhost:5173    # your Vercel URL in production, e.g. https://sanjeevani-ai.vercel.app
ALLOWED_ORIGINS=                      # extra origins, comma separated (custom domain, preview URLs)

# ---- doctor / admin login (no admin registration exists) ----
ADMIN_EMAIL=doctor@example.com
ADMIN_PASSWORD=ChangeThis-Strong-Passw0rd
ADMIN_NAME=Dr. Example
ADMIN_ACCOUNTS=                       # optional extra doctors: [{"email":"a@x.com","password":"...","name":"Dr A"}]
ADMIN_SYNC_PASSWORD=false             # true = re-apply ADMIN_PASSWORD at every boot
ADMIN_REQUIRE_OTP=false               # true = e-mail one-time code for doctors (needs Brevo)

# ---- Brevo e-mail ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sanjeevani AI
REQUIRE_EMAIL_VERIFICATION=false      # set true once Brevo works

# ---- behaviour ----
REQUIRE_FACE_AT_REGISTRATION=true
FACE_MATCH_THRESHOLD=0.5
ENABLE_RLS=false                      # see DEPLOYMENT.md before enabling
COOKIE_SECURE=                        # leave empty: true in production, false otherwise
